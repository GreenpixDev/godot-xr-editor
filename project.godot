; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="XR Editor (dev)"
config/description="Host project for developing and testing the XR Editor plugin."
run/main_scene="res://benchmarks/xr_view_check.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

XREReturnToEditor="*res://addons/xr_editor/playmode/return_to_editor.gd"

[debug]

gdscript/warnings/directory_rules={
"res://addons/blueprints": 1,
"res://addons/xr_editor": 1
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2

[editor_plugins]

enabled=PackedStringArray("res://addons/xr_editor/plugin.cfg", "res://addons/blueprints/plugin.cfg")

[rendering]

vrs/mode=2

[xr]

openxr/enabled=true
openxr/foveation_level=3
openxr/foveation_dynamic=true
shaders/enabled=true
