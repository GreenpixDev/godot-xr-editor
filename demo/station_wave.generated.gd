# Generated by XRE Blueprints. Edit the .tres graph, not this file.
extends Node


# Runtime helpers are copied into generated scripts. Runs and the block library
# come from addons/blueprints/ (XREBlueprintRun, XREBlueprintLibrary, D-051).
signal blueprint_error(block_id: int, message: String)

var _bp_runs: Array[XREBlueprintRun] = []


func _exit_tree() -> void:
	for run: XREBlueprintRun in _bp_runs:
		run.cancel()
	_bp_runs.clear()


func _bp_start(event_id: int, args: Array, policy: String) -> XREBlueprintRun:
	for previous: XREBlueprintRun in _bp_runs:
		if previous.active and previous.event_id == event_id:
			if policy == "ignore":
				return null
			if policy == "restart":
				previous.cancel()
	var run := XREBlueprintRun.new()
	run.event_id = event_id
	run.args = args
	run.host = self
	_bp_runs.append(run)
	return run


func _bp_end(run: XREBlueprintRun) -> void:
	run.cancel()
	_bp_runs.erase(run)


func _bp_alive(run: XREBlueprintRun) -> bool:
	return run != null and run.active and is_inside_tree() and (run.parent == null or _bp_alive(run.parent))


# A call of the graph's own function: a run of its own, with its arguments, under its caller's.
func _bp_child(parent: XREBlueprintRun, args: Array, function_name: String, outputs: Array) -> XREBlueprintRun:
	var depth := parent.depth + 1 if parent != null else 1
	if depth > 64:
		_bp_error(parent, parent.block if parent != null else -1, "Calls of %s nest deeper than 64." % function_name)
		return null
	var run := XREBlueprintRun.new()
	run.parent = parent
	run.depth = depth
	run.function = function_name
	run.args = args
	run.host = self
	run.returned = outputs.duplicate()
	if parent != null:
		run.event_id = parent.event_id
		run.tweens = parent.tweens
		run.players = parent.players
	return run


func _bp_error(run: XREBlueprintRun, block_id: int, message: String) -> void:
	# An error in a function stops the event that called it.
	if run != null and not run.function.is_empty():
		message = "in %s: %s" % [run.function, message]
	var current := run
	while current != null:
		current.cancel()
		current = current.parent
	# An attached error handler can present or record the failure itself.
	if not blueprint_error.has_connections():
		push_error("Blueprints block #%d: %s" % [block_id, message])
	blueprint_error.emit(block_id, message)


func _bp_node(value: Variant, run: XREBlueprintRun, block_id: int) -> Node:
	if not value is Object or not is_instance_valid(value) or not value is Node:
		_bp_error(run, block_id, "Target is missing or is not a Node.")
		return null
	return value as Node


func _bp_target(path: String, run: XREBlueprintRun, block_id: int) -> Node:
	var target := get_node_or_null(NodePath(path))
	if target == null:
		_bp_error(run, block_id, "Missing node: " + path)
	return target


func _bp_accepts(expected: int, actual: int) -> bool:
	# An engine's packed array is an array of its elements (D-143).
	if expected == TYPE_ARRAY and actual >= TYPE_PACKED_BYTE_ARRAY and actual <= TYPE_PACKED_VECTOR4_ARRAY:
		return true
	return expected == TYPE_NIL or expected == actual or (expected == TYPE_FLOAT and actual == TYPE_INT) or (expected in [TYPE_STRING, TYPE_STRING_NAME] and actual in [TYPE_STRING, TYPE_STRING_NAME])


func _bp_argument(run: XREBlueprintRun, event_id: int, index: int, block_id: int) -> Variant:
	if run == null or run.event_id != event_id or index >= run.args.size():
		_bp_error(run, block_id, "Signal argument is outside its event scope.")
		return null
	return run.args[index]


# An argument of a call as its function's parameter type: text to a StringName or a NodePath, an integer to a float.
func _bp_arg(value: Variant, type: int, cls: String, run: XREBlueprintRun, block_id: int) -> Variant:
	if type == TYPE_NIL:
		return value
	if type == TYPE_OBJECT:
		if value == null:
			return null
		if not value is Object or not is_instance_valid(value):
			_bp_error(run, block_id, "Expected an object, got %s." % type_string(typeof(value)))
			return null
		if not cls.is_empty() and ClassDB.class_exists(cls) and not (value as Object).is_class(cls):
			_bp_error(run, block_id, "Expected %s, got %s." % [cls, (value as Object).get_class()])
			return null
		return value
	if type == TYPE_NODE_PATH and value is String:
		return NodePath(value)
	if type == TYPE_STRING_NAME and value is String:
		return StringName(value)
	if type == TYPE_STRING and value is StringName:
		return String(value)
	if not _bp_accepts(type, typeof(value)):
		_bp_error(run, block_id, "Expected %s, got %s." % [type_string(type), type_string(typeof(value))])
		return value
	if type == TYPE_FLOAT and value is int:
		return float(value)
	return value


# The result a call kept when it ran in this event's run.
func _bp_result(run: XREBlueprintRun, block_id: int) -> Variant:
	if run == null or not run.values.has(block_id):
		_bp_error(run, block_id, "The result is read before the block has run.")
		return null
	return run.values[block_id]


# A Sequence (D-138): Then 0 runs now, the other outputs wait in the run's stack.
# Coming back into a Sequence whose frame waits starts it over, so a loop through it doesn't grow the stack.
func _bp_sequence(run: XREBlueprintRun, block_id: int, targets: Array) -> int:
	for index: int in range(run.stack.size() - 1, -1, -1):
		if run.stack[index][0] == block_id:
			run.stack.resize(index)
			break
	if run.stack.size() >= 64:
		_bp_error(run, block_id, "Sequences nest deeper than 64.")
		return -1
	run.stack.append([block_id, 1, targets])
	return targets[0]


# The next output of the innermost Sequence once a chain ends, an empty one passed over; -1 when none waits.
# A loop's frame (D-141) goes on with its next element, then with its Completed.
func _bp_sequence_next(run: XREBlueprintRun) -> int:
	while not run.stack.is_empty():
		var frame: Array = run.stack.back()
		if frame.size() > 3:
			frame[1] += 1
			if frame[1] < (frame[2] as Array).size():
				return frame[3]
			run.stack.pop_back()
			if frame[4] >= 0:
				return frame[4]
			continue
		var targets: Array = frame[2]
		if frame[1] >= targets.size():
			run.stack.pop_back()
			continue
		var target: int = targets[frame[1]]
		frame[1] += 1
		if target >= 0:
			return target
	return -1


# A For Each (D-141): its body for the first element now, the next once the body's chain ended, then Completed.
# It goes over a copy, so the body may change the collection; a dictionary's frame keeps it for its values.
# Coming back into a loop whose frame waits starts it over, as a Sequence does.
func _bp_loop(run: XREBlueprintRun, block_id: int, items: Array, body: int, completed: int, source: Variant = null) -> int:
	for index: int in range(run.stack.size() - 1, -1, -1):
		if run.stack[index][0] == block_id:
			run.stack.resize(index)
			break
	if items.is_empty() or body < 0:
		return completed
	if run.stack.size() >= 64:
		_bp_error(run, block_id, "Loops and Sequences nest deeper than 64.")
		return -1
	run.stack.append([block_id, 0, items.duplicate(), body, completed, source])
	return body


# A loop's Break (D-143): its frame and those inside it go; Completed runs next.
func _bp_loop_break(run: XREBlueprintRun, block_id: int, completed: int) -> int:
	for index: int in range(run.stack.size() - 1, -1, -1):
		if run.stack[index][0] == block_id and run.stack[index].size() > 3:
			run.stack.resize(index)
			return completed
	_bp_error(run, block_id, "Break outside its loop.")
	return -1


# An array, or a packed array of the engine as one (D-143).
func _bp_array(value: Variant) -> Array:
	return value if value is Array else Array(value)


# The scene objects selected for an array (D-143), by their paths from the host; one missing is the block's error.
func _bp_targets(paths: Array, run: XREBlueprintRun, block_id: int) -> Array[Node]:
	var nodes: Array[Node] = []
	for path: Variant in paths:
		var node := _bp_target(str(path), run, block_id)
		if node == null:
			return nodes
		nodes.append(node)
	return nodes


# What a loop gives now (D-141): an array's element and index, a dictionary's key and value.
func _bp_each(run: XREBlueprintRun, block_id: int, port: int) -> Variant:
	for index: int in range(run.stack.size() - 1, -1, -1):
		var frame: Array = run.stack[index]
		if frame[0] != block_id or frame.size() <= 3:
			continue
		var item: Variant = (frame[2] as Array)[frame[1]]
		if port == 1:
			return item
		if frame[5] is Dictionary:
			return (frame[5] as Dictionary).get(item)
		return frame[1]
	_bp_error(run, block_id, "The loop's element is read outside its body.")
	return null


# Whether [param index] is an index of [param items], one past the last too if [param end]; an error if not.
func _bp_index(items: Array, index: Variant, end: bool, run: XREBlueprintRun, block_id: int) -> bool:
	if index is int and int(index) >= 0 and int(index) < items.size() + (1 if end else 0):
		return true
	_bp_error(run, block_id, "Index %s is out of 0…%d." % [index, items.size() - (0 if end else 1)])
	return false


func _bp_at(items: Array, index: Variant, run: XREBlueprintRun, block_id: int) -> Variant:
	return items[int(index)] if _bp_index(items, index, false, run, block_id) else null


func _bp_set_at(items: Array, index: Variant, value: Variant, run: XREBlueprintRun, block_id: int) -> void:
	if _bp_index(items, index, false, run, block_id):
		items[int(index)] = value


func _bp_insert(items: Array, index: Variant, value: Variant, run: XREBlueprintRun, block_id: int) -> void:
	if _bp_index(items, index, true, run, block_id):
		items.insert(int(index), value)


func _bp_remove_at(items: Array, index: Variant, run: XREBlueprintRun, block_id: int) -> void:
	if _bp_index(items, index, false, run, block_id):
		items.remove_at(int(index))


func _bp_pick(items: Array, run: XREBlueprintRun, block_id: int) -> Variant:
	if items.is_empty():
		_bp_error(run, block_id, "Pick Random from an empty array.")
		return null
	return items.pick_random()


# A dictionary's value of a key it has; a key it hasn't is the block's error (Get without Default, D-141).
func _bp_get(items: Dictionary, key: Variant, run: XREBlueprintRun, block_id: int) -> Variant:
	if not items.has(key):
		_bp_error(run, block_id, "No key %s." % [key])
		return null
	return items[key]


# A dictionary's keys and values as arrays of their types.
func _bp_keys(items: Dictionary) -> Array:
	return Array(items.keys(), items.get_typed_key_builtin(), items.get_typed_key_class_name(), items.get_typed_key_script())


func _bp_values(items: Dictionary) -> Array:
	return Array(items.values(), items.get_typed_value_builtin(), items.get_typed_value_class_name(), items.get_typed_value_script())


# What a Break takes apart (D-139): nothing, a value of another type or an object of another class is its error.
func _bp_struct(value: Variant, type: int, cls: String, run: XREBlueprintRun, block_id: int) -> Variant:
	if value == null or (value is Object and not is_instance_valid(value)):
		_bp_error(run, block_id, "Break has nothing to take apart.")
		return null
	if typeof(value) != type:
		_bp_error(run, block_id, "Expected %s, got %s." % [type_string(type), type_string(typeof(value))])
		return null
	if type == TYPE_OBJECT and not cls.is_empty() and not XREBlueprintSchema.is_of_class(value, cls):
		_bp_error(run, block_id, "Expected %s, got %s." % [cls, (value as Object).get_class()])
		return null
	return value


# A field of what a Break took apart (D-139); null stays null, its error already reported.
func _bp_field(value: Variant, name: StringName, run: XREBlueprintRun, block_id: int) -> Variant:
	if value == null:
		return null
	if value is Object:
		if not name in value:
			_bp_error(run, block_id, "No field %s." % name)
			return null
		return (value as Object).get(name)
	return value[name]


# Component [param index] of a broken value (D-084): null stays null, its error already reported.
func _bp_component(value: Variant, index: int) -> Variant:
	if value == null:
		return null
	return value[index]


func _bp_equal(a: Variant, b: Variant) -> bool:
	if typeof(a) != typeof(b) and not (typeof(a) in [TYPE_INT, TYPE_FLOAT] and typeof(b) in [TYPE_INT, TYPE_FLOAT]):
		return false
	return a == b


# An operator (D-065) on the values that came: an error, not a crash, when it can't take them.
func _bp_operate(op: String, a: Variant, b: Variant, run: XREBlueprintRun, block_id: int) -> Variant:
	var problem := XREBlueprintOperators.problem(op, a, b)
	if not problem.is_empty():
		_bp_error(run, block_id, problem)
		return null
	return XREBlueprintOperators.evaluate(op, a, b)


func _bp_check_value(value: Variant, expected: int, run: XREBlueprintRun, block_id: int) -> bool:
	if _bp_accepts(expected, typeof(value)):
		return true
	_bp_error(run, block_id, "Expected %s, got %s." % [type_string(expected), type_string(typeof(value))])
	return false


func _bp_property(target: Node, property: String, expected: int, run: XREBlueprintRun, block_id: int) -> Dictionary:
	if target == null or not _bp_alive(run):
		return {}
	var info := XREBlueprintSchema.property_info(target, property)
	if info.is_empty():
		_bp_error(run, block_id, "Missing property: " + property)
	elif expected != TYPE_NIL and not _bp_accepts(expected, info["type"]):
		_bp_error(run, block_id, "Property type changed: " + property)
		return {}
	return info


func _bp_read(target: Node, property: String, expected: int, run: XREBlueprintRun, block_id: int) -> Variant:
	var info := _bp_property(target, property, expected, run, block_id)
	return info.get("value")


func _bp_write(target: Node, property: String, value: Variant, expected: int, run: XREBlueprintRun, block_id: int) -> void:
	var info := _bp_property(target, property, expected, run, block_id)
	if int(info.get("usage", 0)) & PROPERTY_USAGE_READ_ONLY:
		_bp_error(run, block_id, "Property is read-only: " + property)
		return
	if not info.is_empty() and _bp_check_value(value, info["type"], run, block_id):
		target.set_indexed(NodePath(property), value)


func _bp_connect(path: String, signal_name: String, callback: Callable, argument_count: int, block_id: int) -> void:
	var target := _bp_target(path, null, block_id)
	if target == null:
		return
	for info: Dictionary in target.get_signal_list():
		if str(info["name"]) == signal_name:
			var arguments: Array = info["args"]
			if argument_count != 0 and argument_count != arguments.size():
				_bp_error(null, block_id, "Signal signature changed: " + signal_name)
				return
			var extra := arguments.size() - argument_count
			# The engine emits ready right after _ready(), where this connects: On Ready runs once per _ready().
			target.connect(signal_name, callback.unbind(extra) if extra > 0 else callback, CONNECT_ONE_SHOT if signal_name == "ready" else 0)
			return
	_bp_error(null, block_id, "Missing signal: " + signal_name)


func _ready() -> void:
	pass
	_bp_connect("Button", "area_entered", _bp_event1, 1, 1)


func _bp_event1(arg0: Variant) -> void:
	var run := _bp_start(1, [arg0], "ignore")
	if run == null:
		return
	await _bp_execute(1, run)
	_bp_end(run)


# On Signal #1
func _bp_n1(run: XREBlueprintRun) -> int:
	if not _bp_alive(run):
		return -1
	return 2


# Set Property #2
func _bp_n2(run: XREBlueprintRun) -> int:
	if not _bp_alive(run):
		return -1
	var target := _bp_target("Status", run, 2)
	var value: Variant = "ВОЛНА…"
	_bp_write(target, "text", value, 4, run, 2)
	return 3


# For Each #3
func _bp_n3(run: XREBlueprintRun) -> int:
	if not _bp_alive(run):
		return -1
	var value: Variant = _bp_targets(["Lamps/L1", "Lamps/L2", "Lamps/L3", "Lamps/L4", "Lamps/L5"], run, 3)
	if not _bp_alive(run) or not _bp_check_value(value, 28, run, 3):
		return -1
	return _bp_loop(run, 3, _bp_array(value), 4, 6)


# Tween Property #4
func _bp_n4(run: XREBlueprintRun) -> int:
	if not _bp_alive(run):
		return -1
	var target := _bp_node(_bp_each(run, 3, 1), run, 4)
	if target == null:
		return -1
	var a0: Variant = _bp_arg("light_energy", 4, "", run, 4)
	var a1: Variant = _bp_arg(1.5, 0, "", run, 4)
	var a2: Variant = _bp_arg(0.12, 3, "", run, 4)
	if not _bp_alive(run):
		return -1
	run.block = 4
	await XREBlueprintLibrary.tween_property(target, a0, a1, a2, run)
	if not _bp_alive(run):
		return -1
	return 5


