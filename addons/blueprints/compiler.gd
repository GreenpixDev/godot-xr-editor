@tool
class_name XREBlueprintCompiler
extends RefCounted
## Typed compiler. Every event invocation owns its arguments and cancellation token
## ([XREBlueprintRun]). A call block becomes an ordinary call of its function:
## a method of its Target, a static function of a script class or a utility
## function of @GlobalScope (D-051).

const HEADER := "# Generated by XRE Blueprints. Edit the .tres graph, not this file.\n"
const RUNTIME := "res://addons/blueprints/runtime_template.txt"


## Returns code and block-specific diagnostics. Older graphs are upgraded in memory.
static func compile(source: XREBlueprintGraph) -> Dictionary:
	var graph := XREBlueprintGraph.new()
	graph.restore(source.snapshot())
	graph.upgrade()
	var errors := graph.validate()
	if errors.is_empty(): errors.append_array(_validate_program(graph))
	if not errors.is_empty(): return {"code": "", "errors": errors}
	var code := HEADER + "extends Node\n\n"
	for variable: Dictionary in graph.variables:
		code += "var _bp_var_%s: %s = %s\n" % [variable["name"], type_string(typeof(variable["value"])), var_to_str(variable["value"])]
	code += "\n" + FileAccess.get_file_as_string(RUNTIME)
	code += "\n\nfunc _ready() -> void:\n\tpass\n"
	for block: Dictionary in graph.nodes:
		if block["kind"] == "signal":
			var params: Dictionary = block["params"]
			code += "\t_bp_connect(%s, %s, _bp_event%d, %d, %d)\n" % [var_to_str(params["target"]), var_to_str(params["signal"]), block["id"], (block.get("arguments", []) as Array).size(), block["id"]]
	for block: Dictionary in graph.nodes:
		var id: int = block["id"]
		var kind: String = block["kind"]
		var params: Dictionary = block["params"]
		var title := XREBlueprintGraph.title(block)
		if kind == "signal":
			var signature := PackedStringArray()
			var arguments := PackedStringArray()
			for index: int in (block.get("arguments", []) as Array).size():
				signature.append("arg%d: Variant" % index)
				arguments.append("arg%d" % index)
			code += "\n\nfunc _bp_event%d(%s) -> void:\n\tvar run := _bp_start(%d, [%s], %s)\n\tif run == null:\n\t\treturn\n\tawait _bp_execute(%d, run)\n\t_bp_end(run)\n" % [id, ", ".join(signature), id, ", ".join(arguments), var_to_str(params["policy"]), id]
		if XREBlueprintGraph.is_pure(block) or _has_result(block):
			code += "\n\n# %s #%d\nfunc _bp_value%d(run: XREBlueprintRun = null) -> Variant:\n" % [title, id, id]
			match kind:
				"value": code += "\treturn %s\n" % var_to_str(params["value"])
				"get_variable": code += "\treturn _bp_var_%s\n" % params["variable"]
				"equals": code += "\treturn _bp_equal(%s, %s)\n" % [_input(graph, block, "a"), _input(graph, block, "b")]
				"get_property": code += "\treturn _bp_read(%s, %s, %d, run, %d)\n" % [_target(graph, block), var_to_str(params["property"]), block.get("property_type", TYPE_NIL), id]
				"call":
					if XREBlueprintGraph.is_pure(block): code += _call(graph, block, true)
					else: code += "\treturn _bp_result(run, %d)\n" % id
			if XREBlueprintGraph.is_pure(block): continue
		code += "\n\n# %s #%d\nfunc _bp_n%d(run: XREBlueprintRun) -> int:\n\tif not _bp_alive(run):\n\t\treturn -1\n" % [title, id, id]
		match kind:
			"branch":
				code += "\tvar condition: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(condition, TYPE_BOOL, run, %d):\n\t\treturn -1\n\tif condition:\n%s\telse:\n%s" % [_input(graph, block, "condition"), id, _next(graph, id, 0, "\t\t"), _next(graph, id, 1, "\t\t")]
				continue
			"set_property":
				code += "\tvar target := %s\n\tvar value: Variant = %s\n" % [_target(graph, block), _input(graph, block, "value")]
				code += "\t_bp_write(target, %s, value, %d, run, %d)\n" % [var_to_str(params["property"]), block.get("property_type", TYPE_NIL), id]
			"set_variable":
				var type: int = XREBlueprintGraph.variable_type(graph.find_variable(params["variable"]))
				code += "\tvar value: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(value, %d, run, %d):\n\t\treturn -1\n\t_bp_var_%s = value\n" % [_input(graph, block, "value"), type, id, params["variable"]]
			"call":
				code += _call(graph, block, false)
		code += _next(graph, id, 0, "\t")
	code += "\n\n# Iterative execution permits back edges without recursive call-stack growth.\nfunc _bp_execute(block_id: int, run: XREBlueprintRun) -> void:\n\tvar steps := 0\n\twhile block_id >= 0 and _bp_alive(run):\n\t\tmatch block_id:\n"
	for block: Dictionary in graph.nodes:
		if XREBlueprintGraph.is_pure(block): continue
		code += "\t\t\t%d: block_id = await _bp_n%d(run)\n" % [block["id"], block["id"]]
	code += "\t\t\t_: return\n\t\tsteps += 1\n\t\tif steps >= 64 and block_id >= 0 and _bp_alive(run):\n\t\t\tsteps = 0\n\t\t\tawait get_tree().process_frame\n"
	return {"code": code, "errors": errors}


## Whether an impure call keeps a result for the blocks that read it later.
static func _has_result(block: Dictionary) -> bool:
	return block["kind"] == "call" and not XREBlueprintGraph.is_pure(block) and bool((block["function"] as Dictionary).get("returns", false))


## Statements that compute a call's arguments and call its function: the body
## of a pure block's value function if [param pure], otherwise of its step,
## which keeps a result for later reads.
static func _call(graph: XREBlueprintGraph, block: Dictionary, pure: bool) -> String:
	var function: Dictionary = block["function"]
	var id: int = block["id"]
	var fail := "\t\treturn null\n" if pure else "\t\treturn -1\n"
	var code := ""
	var values := PackedStringArray()
	var index := 0
	for argument: Dictionary in function["args"]:
		if argument.get("run", false):
			values.append("run")
			continue
		if argument.get("fixed", false):
			values.append(var_to_str(argument.get("default")))
			continue
		if argument.get("target", false):
			code += "\tvar target := %s\n\tif target == null:\n%s" % [_target(graph, block), fail]
			# A method is called on its target; a function takes it as an argument.
			if not argument.get("self", false): values.append("target")
			continue
		code += "\tvar a%d: Variant = _bp_arg(%s, %d, %s, run, %d)\n" % [index, _argument(graph, block, argument), argument["type"], var_to_str(str(argument.get("class_name", ""))), id]
		values.append("a%d" % index)
		index += 1
	for extra: int in int(function.get("extra", 0)):
		code += "\tvar a%d: Variant = %s\n" % [index, _input(graph, block, XREBlueprintFunctions.extra_key(extra))]
		values.append("a%d" % index)
		index += 1
	code += "\tif not _bp_alive(run):\n%s" % fail if not pure else "\tif run != null and not _bp_alive(run):\n%s" % fail
	var function_name := str(function["name"])
	var awaits := bool(function.get("awaits", false)) and not pure
	var invocation := ""
	match function["scope"]:
		"method":
			code += "\tif not target.has_method(&%s):\n\t\t_bp_error(run, %d, %s)\n%s" % [var_to_str(function_name), id, var_to_str("Missing method: " + function_name), fail]
			invocation = "%starget.callv(&%s, [%s])" % ["await " if awaits else "", var_to_str(function_name), ", ".join(values)]
		"static":
			invocation = "%s%s.%s(%s)" % ["await " if awaits else "", function["class"], function_name, ", ".join(values)]
		"global":
			invocation = "%s(%s)" % [function_name, ", ".join(values)]
	if pure:
		return code + "\treturn %s\n" % invocation
	code += "\trun.block = %d\n" % id
	if bool(function.get("returns", false)):
		code += "\tvar result: Variant = %s\n\trun.values[%d] = result\n" % [invocation, id]
	else:
		code += "\t%s\n" % invocation
	return code + "\tif not _bp_alive(run):\n\t\treturn -1\n"


## The expression of an argument: its port's wire, its literal, or its default.
static func _argument(graph: XREBlueprintGraph, block: Dictionary, argument: Dictionary) -> String:
	var key := str(argument.get("key", ""))
	var port := graph.input_port(block, key) if not key.is_empty() else -1
	if port >= 0:
		var wired := _wired(graph, block, port)
		if not wired.is_empty(): return wired
	if XREBlueprintFunctions.has_literal(argument):
		return _literal(block["params"][key], int(argument["type"]))
	return var_to_str(argument.get("default")) if argument.has("default") else "null"


## A literal as GDScript of [param type]: text becomes a StringName or a NodePath, an integer a float.
static func _literal(value: Variant, type: int) -> String:
	match type:
		TYPE_STRING_NAME: return "&" + var_to_str(str(value))
		TYPE_NODE_PATH: return "NodePath(%s)" % var_to_str(str(value))
		TYPE_FLOAT:
			if value is int: return var_to_str(float(value))
	return var_to_str(value)


## The source of the wire into port [param port] of [param block], or empty if there is none.
static func _wired(graph: XREBlueprintGraph, block: Dictionary, port: int) -> String:
	for edge: Dictionary in graph.edges:
		if edge["to"] == block["id"] and edge["to_port"] == port:
			var source := graph.find_node(edge["from"])
			if source["kind"] == "signal": return "_bp_argument(run, %d, %d, %d)" % [edge["from"], edge["from_port"] - 1, block["id"]]
			return "_bp_value%d(run)" % edge["from"]
	return ""


## The value of the input of parameter [param key]: its wire's, or the parameter's.
static func _input(graph: XREBlueprintGraph, block: Dictionary, key: String) -> String:
	var wired := _wired(graph, block, graph.input_port(block, key))
	return wired if not wired.is_empty() else var_to_str(block["params"][key])


static func _target(graph: XREBlueprintGraph, block: Dictionary) -> String:
	var wired := _wired(graph, block, XREBlueprintGraph.target_port(block))
	if not wired.is_empty(): return "_bp_node(%s, run, %d)" % [wired, block["id"]]
	return "_bp_target(%s, run, %d)" % [var_to_str(block["params"]["target"]), block["id"]]


static func _next(graph: XREBlueprintGraph, id: int, port: int, indent: String) -> String:
	for edge: Dictionary in graph.edges:
		if edge["from"] == id and edge["from_port"] == port: return "%sreturn %d\n" % [indent, edge["to"]]
	return indent + "return -1\n"


static func _connected(graph: XREBlueprintGraph, id: int, port: int) -> bool:
	if port < 0: return false
	for edge: Dictionary in graph.edges:
		if edge["to"] == id and edge["to_port"] == port: return true
	return false


static func _validate_program(graph: XREBlueprintGraph) -> PackedStringArray:
	var errors := PackedStringArray()
	for variable: Dictionary in graph.variables:
		if not variable.has("value"): errors.append("Variable %s has no start value: put a token in its box." % variable["name"])
	for block: Dictionary in graph.nodes:
		var inputs := graph.ports(block, true)
		for index: int in inputs.size():
			var spec: Array = inputs[index]
			var key: String = spec[2] if spec.size() > 2 else ""
			if key.is_empty() or key == "target" or (block["params"] as Dictionary).has(key) or _connected(graph, block["id"], index): continue
			if block["kind"] == "call" and not _literal_argument(block, key): continue
			errors.append("Block #%d: %s is empty: put a token in or wire it." % [block["id"], spec[0]])
	if not errors.is_empty(): return errors
	var origins: Dictionary = {}
	for event: Dictionary in graph.nodes:
		if not XREBlueprintGraph.is_event(event): continue
		var pending: Array[int] = [event["id"]]
		var seen: Array[int] = []
		while not pending.is_empty():
			var id: int = pending.pop_back()
			if seen.has(id): continue
			seen.append(id)
			if not origins.has(id): origins[id] = []
			(origins[id] as Array).append(event["id"])
			for edge: Dictionary in graph.edges:
				if edge["from"] == id and graph.ports(graph.find_node(id), false)[edge["from_port"]][1] == graph.EXEC: pending.append(edge["to"])
	for block: Dictionary in graph.nodes:
		var id: int = block["id"]
		var params: Dictionary = block["params"]
		if params.has("target") and str(params["target"]).strip_edges().is_empty() and not _connected(graph, id, XREBlueprintGraph.target_port(block)):
			errors.append("Block #%d: missing target." % id)
		if block["kind"] in ["get_variable", "set_variable"] and graph.find_variable(params["variable"]).is_empty(): errors.append("Block #%d: choose an existing variable." % id)
		if block["kind"] in ["set_property", "set_variable"] and not _connected(graph, id, graph.input_port(block, "value")):
			var variable := graph.find_variable(params.get("variable", ""))
			var expected: int = XREBlueprintGraph.variable_type(variable) if block["kind"] == "set_variable" else block.get("property_type", TYPE_NIL)
			if not XREBlueprintSchema.accepts(expected, typeof(params["value"])): errors.append("Block #%d: expected %s, got %s." % [id, XREBlueprintSchema.type_name(expected), type_string(typeof(params["value"]))])
		if block["kind"] == "call":
			errors.append_array(_validate_arguments(graph, block))
		if XREBlueprintGraph.is_pure(block): continue
		var dependencies: Array[int] = [id]
		var seen: Array[int] = []
		while not dependencies.is_empty():
			var current: int = dependencies.pop_back()
			if seen.has(current): continue
			seen.append(current)
			for edge: Dictionary in graph.edges:
				if edge["to"] != current or graph.ports(graph.find_node(current), true)[edge["to_port"]][1] == graph.EXEC: continue
				var source := graph.find_node(edge["from"])
				if source["kind"] == "signal":
					for origin: int in origins.get(id, []):
						if origin != source["id"]: errors.append("Block #%d uses arguments of Signal #%d but also runs from event #%d." % [id, source["id"], origin])
				elif XREBlueprintGraph.is_pure(source): dependencies.append(source["id"])
	return errors


## Whether a call's argument [param key] keeps a literal on the block.
static func _literal_argument(block: Dictionary, key: String) -> bool:
	if key.begins_with(XREBlueprintFunctions.EXTRA_KEY): return true
	for argument: Dictionary in (block["function"] as Dictionary)["args"]:
		if str(argument.get("key", "")) == key: return XREBlueprintFunctions.has_literal(argument)
	return false


## Unconnected arguments of a call: a literal of the argument's type, or an object with a default.
static func _validate_arguments(graph: XREBlueprintGraph, block: Dictionary) -> PackedStringArray:
	var errors := PackedStringArray()
	var id: int = block["id"]
	var function: Dictionary = block["function"]
	for argument: Dictionary in function["args"]:
		if argument.get("run", false) or argument.get("fixed", false) or argument.get("target", false): continue
		var key := str(argument.get("key", ""))
		var port := graph.input_port(block, key) if not key.is_empty() else -1
		if _connected(graph, id, port): continue
		var type := int(argument["type"])
		if not str(argument.get("type_of", "")).is_empty() and block.has("property_type"): type = int(block["property_type"])
		if XREBlueprintFunctions.has_literal(argument):
			var value: Variant = block["params"][key]
			if not str(argument.get("provider", "")).is_empty() and str(value).strip_edges().is_empty():
				errors.append("Block #%d: choose %s." % [id, str(argument["label"]).to_lower()])
				continue
			if type in [TYPE_STRING_NAME, TYPE_NODE_PATH]: type = TYPE_STRING
			if not XREBlueprintSchema.accepts(type, typeof(value)): errors.append("Block #%d: %s expects %s, got %s." % [id, argument["label"], XREBlueprintSchema.type_name(type), type_string(typeof(value))])
		elif type == TYPE_OBJECT and not argument.has("default"):
			errors.append("Block #%d: connect %s." % [id, argument["label"]])
	return errors
