@tool
class_name XREBlueprintCompiler
extends RefCounted
## Typed compiler. Every event invocation owns its arguments and cancellation token
## ([XREBlueprintRun]). A call block becomes an ordinary call of its function:
## a method of its Target, a static function of a script class or a utility
## function of @GlobalScope (D-051). A function of the graph itself
## ([XREBlueprintUserFunctions]) becomes [code]_bp_fn_<name>()[/code], which
## runs its body in a run of its own under the caller's and returns its
## outputs as an Array; its body's blocks are named [code]_bp_f<k>_…[/code].

const HEADER := "# Generated by XRE Blueprints. Edit the .tres graph, not this file.\n"
const RUNTIME := "res://addons/blueprints/runtime_template.txt"
## How far past a loop's ID the step of its Break is (D-143): past any block's.
const BREAK := 1000000

## The prefix of the names of the unit being written: empty for the graph's
## own blocks, [code]f<k>_[/code] for function k's body.
static var _unit := ""
## A step to run is a block's ID; one entered by another input of execution
## than its first — of a function's call or its Return — adds the input's
## place among them times this ([method _follow_exec]).
const ENTERED := 1 << 20


## Returns code and block-specific diagnostics. Older graphs are upgraded in memory.
static func compile(source: XREBlueprintGraph) -> Dictionary:
	var graph := XREBlueprintGraph.new()
	graph.restore(source.snapshot())
	graph.upgrade()
	var errors := graph.validate()
	if errors.is_empty():
		errors.append_array(_validate_program(graph))
		errors.append_array(XREBlueprintUserFunctions.validate_program(graph))
		for entry: Dictionary in graph.functions:
			for error: String in _validate_program(graph.body(str(entry["name"]))): errors.append("Function %s: %s" % [entry["name"], error])
	if not errors.is_empty(): return {"code": "", "errors": errors}
	var code := HEADER + "extends Node\n\n"
	for variable: Dictionary in graph.variables:
		# A collection is declared with its elements' type, Array[int] (D-141).
		var category := XREBlueprintGraph.variable_category(variable)
		var type := XREBlueprintCollections.hint(category) if XREBlueprintCollections.is_collection(category) else type_string(typeof(variable["value"]))
		code += "var _bp_var_%s: %s = %s\n" % [variable["name"], type, _literal(variable["value"], TYPE_NIL)]
	code += "\n" + FileAccess.get_file_as_string(RUNTIME)
	code += "\n\nfunc _ready() -> void:\n\tpass\n"
	for block: Dictionary in graph.nodes:
		if block["kind"] == "signal":
			var params: Dictionary = block["params"]
			code += "\t_bp_connect(%s, %s, _bp_event%d, %d, %d)\n" % [var_to_str(params["target"]), var_to_str(params["signal"]), block["id"], (block.get("arguments", []) as Array).size(), block["id"]]
	_unit = ""
	code += _blocks(graph) + _execute(graph)
	for index: int in graph.functions.size():
		_unit = "f%d_" % index
		code += _function(graph, index)
	_unit = ""
	return {"code": code, "errors": errors}


## A function of the graph ([XREBlueprintUserFunctions]): its arguments start a
## run of their own; a pure one returns its Return's values, read now, another
## runs its body from its Entry — from the output of execution its call was
## entered by, [code]entered[/code] — and returns which way a Return left,
## then what it gave.
static func _function(graph: XREBlueprintGraph, index: int) -> String:
	var entry: Dictionary = graph.functions[index]
	var name := str(entry["name"])
	var body := graph.body(name)
	var pure := bool(entry["pure"])
	var parameters := PackedStringArray(["parent: XREBlueprintRun"])
	if not pure: parameters.append("entered: int")
	var arguments := PackedStringArray()
	for pin: Dictionary in entry["inputs"] as Array:
		if XREBlueprintUserFunctions.is_exec(pin): continue
		parameters.append("a%d: Variant" % arguments.size())
		arguments.append("a%d" % arguments.size())
	var defaults: Array = []
	for pin: Dictionary in entry["outputs"] as Array:
		if not XREBlueprintUserFunctions.is_exec(pin): defaults.append(XREBlueprintSchema.default_value(XREBlueprintUserFunctions.pin_type(pin)))
	var failed: Array = defaults if pure else [0] + defaults
	var code := "\n\n# Function %s\nfunc _bp_fn_%s(%s) -> Array:\n\tvar run := _bp_child(parent, [%s], %s, %s)\n\tif run == null:\n\t\treturn %s\n" % [name, name,
			", ".join(parameters), ", ".join(arguments), var_to_str(name), var_to_str(defaults), var_to_str(failed)]
	var start := 0
	var finish := 0
	for block: Dictionary in body.nodes:
		if block["kind"] == "entry": start = block["id"]
		if block["kind"] == "return": finish = block["id"]
	if pure:
		code += "\treturn [%s]\n" % ", ".join(_returned(body, body.find_node(finish)))
	else:
		# Where each way in starts: Then, then each input of execution.
		var starts: Array = []
		var outputs := body.ports(body.find_node(start), false)
		for port: int in outputs.size():
			if outputs[port][1] == XREBlueprintGraph.EXEC: starts.append(_follow_exec(body, start, port))
		if starts.size() == 1:
			if int(starts[0]) >= 0: code += "\tawait %s(%d, run)\n" % [_execute_name(), starts[0]]
		else:
			code += "\tvar first: int = %s[entered] if entered < %d else -1\n\tif first >= 0:\n\t\tawait %s(first, run)\n" % [var_to_str(starts), starts.size(), _execute_name()]
		code += "\tvar result: Array = [run.exit]\n\tresult.append_array(run.returned)\n\treturn result\n"
	code += _blocks(body)
	if not pure: code += _execute(body)
	return code


## The values a Return gives, one per output of its function: its wire's, or its literal.
static func _returned(graph: XREBlueprintGraph, block: Dictionary) -> PackedStringArray:
	var values := PackedStringArray()
	var inputs := graph.ports(block, true)
	for port: int in inputs.size():
		var spec: Array = inputs[port]
		if spec[1] == XREBlueprintGraph.EXEC: continue
		var wired := _wired(graph, block, port)
		var key: String = spec[2]
		values.append(wired if not wired.is_empty() else var_to_str((block["params"] as Dictionary).get(key)) if not key.is_empty() else "null")
	return values


static func _value_name(id: int) -> String:
	return "_bp_%svalue%d" % [_unit, id]


static func _step_name(id: int) -> String:
	return "_bp_%sn%d" % [_unit, id]


static func _execute_name() -> String:
	return "_bp_%sexecute" % _unit


## The value functions and steps of the blocks of [param graph], the graph's
## own or a function's body: an event's function too, an Entry nothing.
static func _blocks(graph: XREBlueprintGraph) -> String:
	var code := ""
	var pure_body := bool(graph.function_signature.get("pure", false))
	for block: Dictionary in graph.nodes:
		var id: int = block["id"]
		var kind: String = block["kind"]
		var params: Dictionary = block["params"]
		var title := XREBlueprintGraph.title(block)
		if kind == "signal":
			var signature := PackedStringArray()
			var arguments := PackedStringArray()
			for index: int in (block.get("arguments", []) as Array).size():
				signature.append("arg%d: Variant" % index)
				arguments.append("arg%d" % index)
			code += "\n\nfunc _bp_event%d(%s) -> void:\n\tvar run := _bp_start(%d, [%s], %s)\n\tif run == null:\n\t\treturn\n\tawait _bp_execute(%d, run)\n\t_bp_end(run)\n" % [id, ", ".join(signature), id, ", ".join(arguments), var_to_str(params["policy"]), id]
		if XREBlueprintGraph.is_pure(block) or _has_result(block):
			code += "\n\n# %s #%d\nfunc %s(run: XREBlueprintRun = null) -> Variant:\n" % [title, id, _value_name(id)]
			match kind:
				"value": code += "\treturn %s\n" % var_to_str(params["value"])
				"get_variable": code += "\treturn _bp_var_%s\n" % params["variable"]
				"equals": code += "\treturn _bp_equal(%s, %s)\n" % [_input(graph, block, "a"), _input(graph, block, "b")]
				"operator":
					var op := XREBlueprintGraph.operator_of(block)
					var second := "null" if XREBlueprintOperators.is_unary(op) else _input(graph, block, "b")
					var count := XREBlueprintGraph.operand_count(block)
					if count <= 2:
						code += "\treturn _bp_operate(%s, %s, %s, run, %d)\n" % [var_to_str(op), _input(graph, block, "a"), second, id]
					else:
						# Folded from the left (D-136); an operand that failed has reported its error.
						code += "\tvar value: Variant = _bp_operate(%s, %s, %s, run, %d)\n" % [var_to_str(op), _input(graph, block, "a"), second, id]
						for index: int in range(2, count):
							var operand := _input(graph, block, XREBlueprintOperators.OPERAND_KEYS[index])
							code += "\tif value == null:\n\t\treturn null\n\tvalue = _bp_operate(%s, value, %s, run, %d)\n" % [var_to_str(op), operand, id]
						code += "\treturn value\n"
				"get_property": code += "\treturn _bp_read(%s, %s, %d, run, %d)\n" % [_target(graph, block), var_to_str(params["property"]), block.get("property_type", TYPE_NIL), id]
				"break", "make":
					# One value a step (D-139): each output read in a step takes its field from the same one.
					code += "\tif run != null and run.has_snapshot(%d):\n\t\treturn run.snapshots[%d][1]\n" % [id, id]
					code += _struct_value(graph, block)
					code += "\tif run != null:\n\t\trun.keep(%d, value)\n\treturn value\n" % id
				"call":
					if XREBlueprintGraph.is_pure(block): code += _call(graph, block, true)
					else: code += "\treturn _bp_result(run, %d)\n" % id
				"make_array", "make_dictionary": code += _make_collection(graph, block)
				"collection": code += _collection_call(graph, block, true)
			if XREBlueprintGraph.is_pure(block): continue
		# An Entry is where a body starts; a pure function's Return is read, not run.
		if kind == "entry" or kind == "return" and pure_body: continue
		# A function's call and a Return know which input of execution they were entered by.
		var entered := ", entered: int = 0" if _entered_by(block) else ""
		code += "\n\n# %s #%d\nfunc %s(run: XREBlueprintRun%s) -> int:\n\tif not _bp_alive(run):\n\t\treturn -1\n" % [title, id, _step_name(id), entered]
		match kind:
			"return":
				# What it gives and which way it leaves end the body, Sequences waiting in it too.
				code += "\trun.returned = [%s]\n\trun.exit = entered\n\trun.stack.clear()\n\treturn -1\n" % ", ".join(_returned(graph, block))
				continue
			"branch":
				code += "\tvar condition: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(condition, TYPE_BOOL, run, %d):\n\t\treturn -1\n\tif condition:\n%s\telse:\n%s" % [_input(graph, block, "condition"), id, _next(graph, id, 0, "\t\t"), _next(graph, id, 1, "\t\t")]
				continue
			"sequence":
				# Then 0 now; the others wait in the run's stack for the chain before them to end (D-138).
				# Untyped, so that the generated code reads [7, 9, 12].
				var targets: Array = []
				for port: int in XREBlueprintGraph.pin_count(block): targets.append(_follow_exec(graph, id, port))
				code += "\treturn _bp_sequence(run, %d, %s)\n" % [id, var_to_str(targets)]
				continue
			"switch":
				var on := str(params["on"])
				# An enumeration's names become its numbers, each named beside it.
				var constants := XREBlueprintGraph.enum_constants(str(params.get("enum", ""))) if on == "enum" else {}
				var selection := _input(graph, block, "selection")
				if on == "enum" and not _connected(graph, id, graph.input_port(block, "selection")): selection = var_to_str(constants.get(params["selection"], -1))
				code += "\tvar selection: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(selection, %d, run, %d):\n\t\treturn -1\n\tmatch selection:\n" % [selection, TYPE_STRING if on == "string" else TYPE_INT, id]
				var count := XREBlueprintGraph.pin_count(block)
				for port: int in count:
					var value: Variant = params[XREBlueprintGraph.case_key(port)]
					var pattern := var_to_str(constants.get(value, -1)) if on == "enum" else var_to_str(value)
					code += "\t\t%s:%s\n%s" % [pattern, "  # " + str(value) if on == "enum" else "", _next(graph, id, port, "\t\t\t")]
				code += "\t\t_:\n%s" % _next(graph, id, count, "\t\t\t")
				continue
			"set_property":
				code += "\tvar target := %s\n\tvar value: Variant = %s\n" % [_target(graph, block), _input(graph, block, "value")]
				code += "\t_bp_write(target, %s, value, %d, run, %d)\n" % [var_to_str(params["property"]), block.get("property_type", TYPE_NIL), id]
			"set_variable":
				var type: int = XREBlueprintGraph.variable_type(graph.find_variable(params["variable"]))
				code += "\tvar value: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(value, %d, run, %d):\n\t\treturn -1\n" % [_input(graph, block, "value"), type, id]
				# A collection takes the elements, converted to its own elements' type (D-141).
				code += ("\t_bp_var_%s.assign(value)\n" if type == TYPE_DICTIONARY else "\t_bp_var_%s.assign(_bp_array(value))\n" if type == TYPE_ARRAY else "\t_bp_var_%s = value\n") % params["variable"]
			"call":
				code += _call(graph, block, false)
				# A function left another way than Then goes on from that output of execution.
				var ways := _exec_ports(graph, block, false)
				if XREBlueprintUserFunctions.is_call(block) and ways.size() > 1:
					code += "\tmatch int(result[0]):\n"
					for way: int in range(1, ways.size()): code += "\t\t%d:\n%s" % [way, _next(graph, id, ways[way], "\t\t\t")]
			"for_each", "for_each_pair":
				# The body runs once an element, the next once its chain ended, then Completed (D-141).
				var pair := kind == "for_each_pair"
				code += "\tvar value: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(value, %d, run, %d):\n\t\treturn -1\n" % [_held_collection(graph, block), TYPE_DICTIONARY if pair else TYPE_ARRAY, id]
				if pair: code += "\tvar items: Dictionary = value\n\treturn _bp_loop(run, %d, items.keys(), %d, %d, items)\n" % [id, _follow_exec(graph, id, 0), _follow_exec(graph, id, 3)]
				else: code += "\treturn _bp_loop(run, %d, _bp_array(value), %d, %d)\n" % [id, _follow_exec(graph, id, 0), _follow_exec(graph, id, 3)]
				continue
			"collection":
				code += _collection_call(graph, block, false)
		code += _next(graph, id, 0, "\t")
	return code


## Whether [param block]'s step knows which input of execution it was entered by:
## a call of a function of the graph, a Return.
static func _entered_by(block: Dictionary) -> bool:
	return block["kind"] == "return" or XREBlueprintUserFunctions.is_call(block) and not XREBlueprintGraph.is_pure(block)


## The ports of execution among [param block]'s inputs or outputs.
static func _exec_ports(graph: XREBlueprintGraph, block: Dictionary, input: bool) -> Array[int]:
	var result: Array[int] = []
	var ports := graph.ports(block, input)
	for port: int in ports.size():
		if ports[port][1] == XREBlueprintGraph.EXEC: result.append(port)
	return result


## Where among [param block]'s ports of a value [param port] is: what an Array of its values has it at.
static func _value_index(graph: XREBlueprintGraph, block: Dictionary, port: int, input: bool) -> int:
	var ports := graph.ports(block, input)
	var index := 0
	for at: int in mini(port, ports.size()):
		if ports[at][1] != XREBlueprintGraph.EXEC: index += 1
	return index


## The loop that runs the steps of [param graph] from a block.
static func _execute(graph: XREBlueprintGraph) -> String:
	var code := "\n\n# Iterative execution permits back edges without recursive call-stack growth.\nfunc %s(block_id: int, run: XREBlueprintRun) -> void:\n\tvar steps := 0\n" % _execute_name()
	if graph.nodes.any(func(block: Dictionary) -> bool: return block["kind"] in ["sequence", "for_each", "for_each_pair"]):
		# A chain that ends goes on with the next output of the Sequence it came from (D-138), or the loop's next element (D-141).
		code += "\twhile _bp_alive(run):\n\t\tif block_id < 0:\n\t\t\tblock_id = _bp_sequence_next(run)\n\t\t\tif block_id < 0:\n\t\t\t\treturn\n\t\tmatch block_id:\n"
	else:
		code += "\twhile block_id >= 0 and _bp_alive(run):\n\t\tmatch block_id:\n"
	for block: Dictionary in graph.nodes:
		if XREBlueprintGraph.is_pure(block) or block["kind"] == "entry": continue
		code += "\t\t\t%d: block_id = await %s(run)\n" % [block["id"], _step_name(block["id"])]
		# A loop's Break (D-143): its frame goes, Completed runs.
		if block["kind"] in ["for_each", "for_each_pair"]: code += "\t\t\t%d: block_id = _bp_loop_break(run, %d, %d)\n" % [BREAK + int(block["id"]), block["id"], _follow_exec(graph, block["id"], 3)]
		if not _entered_by(block): continue
		for way: int in range(1, _exec_ports(graph, block, true).size()):
			code += "\t\t\t%d: block_id = await %s(run, %d)\n" % [block["id"] + way * ENTERED, _step_name(block["id"]), way]
	code += "\t\t\t_: return\n"
	# A new step reads Break and Make anew (D-139).
	if graph.nodes.any(func(block: Dictionary) -> bool: return block["kind"] in ["break", "make"]): code += "\t\trun.step += 1\n"
	code += "\t\tsteps += 1\n\t\tif steps >= 64 and block_id >= 0 and _bp_alive(run):\n\t\t\tsteps = 0\n\t\t\tawait get_tree().process_frame\n"
	return code


## Whether an impure call keeps a result for the blocks that read it later.
static func _has_result(block: Dictionary) -> bool:
	return block["kind"] == "call" and not XREBlueprintGraph.is_pure(block) and bool((block["function"] as Dictionary).get("returns", false))


## Statements that compute a call's arguments and call its function: the body
## of a pure block's value function if [param pure], otherwise of its step,
## which keeps a result for later reads.
static func _call(graph: XREBlueprintGraph, block: Dictionary, pure: bool) -> String:
	var function: Dictionary = block["function"]
	var id: int = block["id"]
	var fail := "\t\treturn null\n" if pure else "\t\treturn -1\n"
	var code := ""
	var values := PackedStringArray()
	var index := 0
	for argument: Dictionary in function["args"]:
		if argument.get("run", false):
			values.append("run")
			continue
		if argument.get("fixed", false):
			values.append(var_to_str(argument.get("default")))
			continue
		if argument.get("target", false):
			code += "\tvar target := %s\n\tif target == null:\n%s" % [_target(graph, block), fail]
			# A method is called on its target; a function takes it as an argument.
			if not argument.get("self", false): values.append("target")
			continue
		code += "\tvar a%d: Variant = _bp_arg(%s, %d, %s, run, %d)\n" % [index, _argument(graph, block, argument), argument["type"], var_to_str(str(argument.get("class_name", ""))), id]
		values.append("a%d" % index)
		index += 1
	for extra: int in int(function.get("extra", 0)):
		code += "\tvar a%d: Variant = %s\n" % [index, _input(graph, block, XREBlueprintFunctions.extra_key(extra))]
		values.append("a%d" % index)
		index += 1
	code += "\tif not _bp_alive(run):\n%s" % fail if not pure else "\tif run != null and not _bp_alive(run):\n%s" % fail
	var function_name := str(function["name"])
	# A call of the graph's own function is awaited: its body may wait.
	var awaits: bool = (bool(function.get("awaits", false)) or function["scope"] == "local") and not pure
	var invocation := ""
	match function["scope"]:
		"method":
			code += "\tif not target.has_method(&%s):\n\t\t_bp_error(run, %d, %s)\n%s" % [var_to_str(function_name), id, var_to_str("Missing method: " + function_name), fail]
			invocation = "%starget.callv(&%s, [%s])" % ["await " if awaits else "", var_to_str(function_name), ", ".join(values)]
		"static":
			invocation = "%s%s.%s(%s)" % ["await " if awaits else "", function["class"], function_name, ", ".join(values)]
		"global":
			invocation = "%s(%s)" % [function_name, ", ".join(values)]
		"local":
			values.insert(0, "run")
			if not pure: values.insert(1, "entered")
			invocation = "%s_bp_fn_%s(%s)" % ["await " if awaits else "", function_name, ", ".join(values)]
	if pure:
		return code + "\treturn %s\n" % invocation
	code += "\trun.block = %d\n" % id
	if bool(function.get("returns", false)):
		code += "\tvar result: Variant = %s\n\trun.values[%d] = result\n" % [invocation, id]
	else:
		code += "\t%s\n" % invocation
	return code + "\tif not _bp_alive(run):\n\t\treturn -1\n"


## The expression of an argument: its port's wire, its literal, or its default.
static func _argument(graph: XREBlueprintGraph, block: Dictionary, argument: Dictionary) -> String:
	var key := str(argument.get("key", ""))
	var port := graph.input_port(block, key) if not key.is_empty() else -1
	if port >= 0:
		var wired := _wired(graph, block, port)
		if not wired.is_empty(): return wired
	if XREBlueprintFunctions.has_literal(argument):
		return _literal(block["params"][key], int(argument["type"]))
	return var_to_str(argument.get("default")) if argument.has("default") else "null"


## A literal as GDScript of [param type]: text becomes a StringName or a NodePath, an integer a float.
## A collection is its list, [1, 2]: GDScript has no Array[int]([1, 2]), its declaration types it (D-141).
static func _literal(value: Variant, type: int) -> String:
	if value is Array or value is Dictionary: return XREBlueprintCollections.text_of(value)
	match type:
		TYPE_STRING_NAME: return "&" + var_to_str(str(value))
		TYPE_NODE_PATH: return "NodePath(%s)" % var_to_str(str(value))
		TYPE_FLOAT:
			if value is int: return var_to_str(float(value))
	return var_to_str(value)


## The source of the wire into port [param port] of [param block], or empty if there is none.
static func _wired(graph: XREBlueprintGraph, block: Dictionary, port: int) -> String:
	for edge: Dictionary in graph.edges:
		if edge["to"] == block["id"] and edge["to_port"] == port:
			var source := graph.find_node(edge["from"])
			if source["kind"] == "signal": return "_bp_argument(run, %d, %d, %d)" % [edge["from"], edge["from_port"] - 1, block["id"]]
			# A body's Entry gives the function's arguments, after its Then unless it is pure.
			if source["kind"] == "entry": return "run.args[%d]" % _value_index(graph, source, edge["from_port"], false)
			if source["kind"] == "break":
				var outputs := graph.ports(source, false)
				var field := str(outputs[edge["from_port"]][2]) if edge["from_port"] < outputs.size() else ""
				return "_bp_field(%s(run), &%s, run, %d)" % [_value_name(edge["from"]), var_to_str(field), edge["from"]]
			if source["kind"] == "call" and not ((source["function"] as Dictionary).get("break", []) as Array).is_empty():
				return "_bp_component(%s(run), %d)" % [_value_name(edge["from"]), edge["from_port"]]
			# A function's outputs of values come as an Array, after the way it left unless it is pure.
			if XREBlueprintUserFunctions.is_call(source):
				var after := 0 if (source["function"] as Dictionary).get("pure", false) else 1
				return "_bp_component(%s(run), %d)" % [_value_name(edge["from"]), _value_index(graph, source, edge["from_port"], false) + after]
			# A loop's element, index, key or value now (D-141).
			if source["kind"] in ["for_each", "for_each_pair"]: return "_bp_each(run, %d, %d)" % [edge["from"], edge["from_port"]]
			return "%s(run)" % _value_name(edge["from"])
	return ""


## The value of the input of parameter [param key]: its wire's, or the parameter's.
static func _input(graph: XREBlueprintGraph, block: Dictionary, key: String) -> String:
	var wired := _wired(graph, block, graph.input_port(block, key))
	return wired if not wired.is_empty() else _literal(block["params"][key], TYPE_NIL)


static func _target(graph: XREBlueprintGraph, block: Dictionary) -> String:
	var wired := _wired(graph, block, XREBlueprintGraph.target_port(block))
	if not wired.is_empty(): return "_bp_node(%s, run, %d)" % [wired, block["id"]]
	return "_bp_target(%s, run, %d)" % [var_to_str(block["params"]["target"]), block["id"]]


static func _next(graph: XREBlueprintGraph, id: int, port: int, indent: String) -> String:
	return "%sreturn %d\n" % [indent, _follow_exec(graph, id, port)]


## The step execution output [param port] of block [param id] goes to, -1 for
## none: the block's ID, and the place of the input among its inputs of
## execution times [constant ENTERED] when it knows it ([method _entered_by]);
## a loop's Break, [constant BREAK] past its ID (D-143).
static func _follow_exec(graph: XREBlueprintGraph, id: int, port: int) -> int:
	for edge: Dictionary in graph.edges:
		if edge["from"] != id or edge["from_port"] != port: continue
		var target := graph.find_node(int(edge["to"]))
		if target.get("kind") in ["for_each", "for_each_pair"] and int(edge["to_port"]) == 2: return BREAK + int(edge["to"])
		if target.is_empty() or not _entered_by(target): return edge["to"]
		return int(edge["to"]) + maxi(_exec_ports(graph, target, true).find(int(edge["to_port"])), 0) * ENTERED
	return -1


static func _connected(graph: XREBlueprintGraph, id: int, port: int) -> bool:
	if port < 0: return false
	for edge: Dictionary in graph.edges:
		if edge["to"] == id and edge["to_port"] == port: return true
	return false


static func _validate_program(graph: XREBlueprintGraph) -> PackedStringArray:
	var errors := PackedStringArray()
	for variable: Dictionary in graph.variables:
		if not variable.has("value"): errors.append("Variable %s has no start value: put a token in its box." % variable["name"])
	for block: Dictionary in graph.nodes:
		var inputs := graph.ports(block, true)
		for index: int in inputs.size():
			var spec: Array = inputs[index]
			var key: String = spec[2] if spec.size() > 2 else ""
			if key.is_empty() or key == "target" or (block["params"] as Dictionary).has(key) or _connected(graph, block["id"], index): continue
			if block["kind"] == "call" and not _literal_argument(block, key): continue
			# An untyped Break says how to give it a type instead ([method _validate_struct], D-139).
			if block["kind"] == "break" and (block.get("struct", {}) as Dictionary).is_empty(): continue
			# A collection only a wire brings (D-141); Get's Default may stay empty.
			if key == "collection" and XREBlueprintGraph.holds_collection(block): continue
			if block["kind"] in XREBlueprintGraph.COLLECTION_KINDS and (key in ["collection", "other"] or XREBlueprintGraph.variant_type(spec[1]) == TYPE_OBJECT):
				errors.append("Block #%d: wire %s." % [block["id"], spec[0]])
				continue
			if block["kind"] == "collection" and key in (XREBlueprintCollections.METHODS[block["params"]["method"]] as Dictionary).get("optional", []): continue
			errors.append("Block #%d: %s is empty: put a token in or wire it." % [block["id"], spec[0]])
	if not errors.is_empty(): return errors
	var origins: Dictionary = {}
	for event: Dictionary in graph.nodes:
		if not XREBlueprintGraph.is_event(event): continue
		var pending: Array[int] = [event["id"]]
		var seen: Array[int] = []
		while not pending.is_empty():
			var id: int = pending.pop_back()
			if seen.has(id): continue
			seen.append(id)
			if not origins.has(id): origins[id] = []
			(origins[id] as Array).append(event["id"])
			for edge: Dictionary in graph.edges:
				if edge["from"] == id and graph.ports(graph.find_node(id), false)[edge["from_port"]][1] == graph.EXEC: pending.append(edge["to"])
	for block: Dictionary in graph.nodes:
		var id: int = block["id"]
		var params: Dictionary = block["params"]
		if params.has("target") and str(params["target"]).strip_edges().is_empty() and not _connected(graph, id, XREBlueprintGraph.target_port(block)):
			errors.append("Block #%d: missing target." % id)
		if block["kind"] in ["get_variable", "set_variable"] and graph.find_variable(params["variable"]).is_empty(): errors.append("Block #%d: choose an existing variable." % id)
		if block["kind"] in ["set_property", "set_variable"] and not _connected(graph, id, graph.input_port(block, "value")):
			var variable := graph.find_variable(params.get("variable", ""))
			var expected: int = XREBlueprintGraph.variable_type(variable) if block["kind"] == "set_variable" else block.get("property_type", TYPE_NIL)
			if not XREBlueprintSchema.accepts(expected, typeof(params["value"])): errors.append("Block #%d: expected %s, got %s." % [id, XREBlueprintSchema.type_name(expected), type_string(typeof(params["value"]))])
			elif block["kind"] == "set_variable" and expected in [TYPE_ARRAY, TYPE_DICTIONARY] and XREBlueprintCollections.category_of(params["value"]) != XREBlueprintGraph.variable_category(variable):
				errors.append("Block #%d: expected %s, got %s." % [id, XREBlueprintCollections.hint(XREBlueprintGraph.variable_category(variable)), XREBlueprintCollections.hint(XREBlueprintCollections.category_of(params["value"]))])
		if block["kind"] in XREBlueprintGraph.COLLECTION_KINDS: errors.append_array(_validate_collection(graph, block))
		if block["kind"] == "call":
			errors.append_array(_validate_arguments(graph, block))
		if block["kind"] == "operator":
			errors.append_array(_validate_operator(graph, block))
		if block["kind"] in ["break", "make"]: errors.append_array(_validate_struct(graph, block))
		if block["kind"] == "switch":
			# Each case once (D-138): a second one could never run.
			var seen: Array = []
			for port: int in XREBlueprintGraph.pin_count(block):
				var value: Variant = params[XREBlueprintGraph.case_key(port)]
				if seen.has(value): errors.append("Block #%d: case %s repeats." % [id, XREBlueprintGraph.case_label(block, port)])
				seen.append(value)
		if XREBlueprintGraph.is_pure(block): continue
		var dependencies: Array[int] = [id]
		var seen: Array[int] = []
		while not dependencies.is_empty():
			var current: int = dependencies.pop_back()
			if seen.has(current): continue
			seen.append(current)
			for edge: Dictionary in graph.edges:
				if edge["to"] != current or graph.ports(graph.find_node(current), true)[edge["to_port"]][1] == graph.EXEC: continue
				var source := graph.find_node(edge["from"])
				if source["kind"] == "signal":
					for origin: int in origins.get(id, []):
						if origin != source["id"]: errors.append("Block #%d uses arguments of Signal #%d but also runs from event #%d." % [id, source["id"], origin])
				elif XREBlueprintGraph.is_pure(source): dependencies.append(source["id"])
	return errors


## The statements of a Break's or a Make's value (D-139), into [code]value[/code]:
## the value checked to be of its type and class, or one built — a built-in
## value by its members, an object by [code]new()[/code] and its fields; a
## hidden field keeps its default.
static func _struct_value(graph: XREBlueprintGraph, block: Dictionary) -> String:
	var struct: Dictionary = block["struct"]
	var type := int(struct["type"])
	var id: int = block["id"]
	if block["kind"] == "break":
		return "\tvar value: Variant = _bp_struct(%s, %d, %s, run, %d)\n" % [_input(graph, block, "value"), type, var_to_str(str(struct.get("class", ""))), id]
	# Typed by what it is, so that its members are set safely.
	var code := "\tvar value := %s\n" % (str(struct["class"]) + ".new()" if type == TYPE_OBJECT else type_string(type) + "()")
	for field: Dictionary in XREBlueprintStructs.shown(block):
		var name := str(field["name"])
		if type == TYPE_OBJECT: code += "\tvalue.set(&%s, %s)\n" % [var_to_str(name), _input(graph, block, name)]
		else: code += "\tvalue.%s = %s\n" % [name, _input(graph, block, name)]
	return code


## The statements of Make Array's or Make Dictionary's value (D-141): a new
## typed literal, [code][1, 2, 5][/code] or [code]{"open": a, "closed": b}[/code],
## of its elements' wires and literals. Each read makes a new one.
static func _make_collection(graph: XREBlueprintGraph, block: Dictionary) -> String:
	var category: int = graph.ports(block, false)[0][1]
	var items := PackedStringArray()
	for index: int in XREBlueprintGraph.collection_count(block):
		if block["kind"] == "make_array":
			items.append(_item(graph, block, "item_%d" % index, XREBlueprintCollections.element_of(category)))
		else:
			items.append("%s: %s" % [_item(graph, block, "key_%d" % index, XREBlueprintCollections.key_of(category)), _item(graph, block, "value_%d" % index, XREBlueprintCollections.element_of(category))])
	var literal := "[%s]" % ", ".join(items) if block["kind"] == "make_array" else "{%s}" % ", ".join(items)
	return "\tvar value: %s = %s\n\treturn value\n" % [XREBlueprintCollections.hint(category), literal]


## An element, key or value of a Make block: its wire, or its literal as one of [param category].
static func _item(graph: XREBlueprintGraph, block: Dictionary, key: String, category: int) -> String:
	var wired := _wired(graph, block, graph.input_port(block, key))
	return wired if not wired.is_empty() else _literal(block["params"][key], XREBlueprintGraph.variant_type(category))


## The statements of a block of a method of Array or Dictionary (D-141): the
## collection, checked to be one, as [code]items[/code], each argument by its
## wire or literal, then the method's GDScript ([constant XREBlueprintCollections.METHODS]):
## returned for a pure one, run for one with execution, which stops on a failed check.
static func _collection_call(graph: XREBlueprintGraph, block: Dictionary, pure: bool) -> String:
	var id: int = block["id"]
	var params: Dictionary = block["params"]
	var info: Dictionary = XREBlueprintCollections.METHODS[params["method"]]
	var dictionary := XREBlueprintGraph.on_dictionary(block)
	var category := graph.collection_type(block)
	var fail := "\t\treturn null\n" if pure else "\t\treturn -1\n"
	var code := "\tvar value: Variant = %s\n" % _held_collection(graph, block)
	code += "\tif %snot _bp_check_value(value, %d, run, %d):\n%s" % ["" if pure else "not _bp_alive(run) or ", TYPE_DICTIONARY if dictionary else TYPE_ARRAY, id, fail]
	code += "\tvar items: Dictionary = value\n" if dictionary else "\tvar items := _bp_array(value)\n"
	var values := {"items": "items", "id": str(id)}
	var strict := false
	var index := 0
	for argument: Array in info["args"]:
		var key := str(argument[2])
		var wired := _wired(graph, block, graph.input_port(block, key))
		if wired.is_empty() and not params.has(key):
			# An optional argument left empty: the method's strict form (Get without Default).
			strict = true
			continue
		var expression := wired if not wired.is_empty() else _literal(params[key], XREBlueprintGraph.variant_type(XREBlueprintCollections.role_category(str(argument[1]), category)))
		code += "\tvar a%d: Variant = %s\n" % [index, expression]
		values[str(index)] = "a%d" % index
		index += 1
	var statement := str(info["strict"] if strict else info["code"]).format(values)
	if pure: return code + "\treturn %s\n" % statement
	return code + "\t%s\n" % statement.replace("\n", "\n\t")


## What keeps a collection block from building (D-141): a collection wired
## into an element, key or value — they don't nest —, a literal of another type
## than its port's, a method with execution that changes the new collection a
## Make block gives, which no block could read after.
static func _validate_collection(graph: XREBlueprintGraph, block: Dictionary) -> PackedStringArray:
	var errors := PackedStringArray()
	var id: int = block["id"]
	var params: Dictionary = block["params"]
	var inputs := graph.ports(block, true)
	for index: int in inputs.size():
		var spec: Array = inputs[index]
		var key := str(spec[2]) if spec.size() > 2 else ""
		var wired := graph.source_category(block, index)
		if block["kind"] in ["make_array", "make_dictionary"] and XREBlueprintCollections.is_collection(wired):
			errors.append("Block #%d: %s can't hold a collection: arrays and dictionaries don't nest." % [id, spec[0]])
		if wired >= 0 or key.is_empty() or not params.has(key): continue
		var type := XREBlueprintGraph.variant_type(spec[1])
		if block["kind"] != "collection" or type == TYPE_NIL: continue
		if not XREBlueprintSchema.accepts(type, typeof(params[key])): errors.append("Block #%d: %s expects %s, got %s." % [id, spec[0], XREBlueprintSchema.type_name(type), type_string(typeof(params[key]))])
	if block["kind"] == "collection" and not XREBlueprintGraph.is_pure(block):
		# A rack's list and the selected objects are made anew on each read, as Make's (D-143).
		if XREBlueprintGraph.holds_collection(block) and graph.source_category(block, graph.input_port(block, "collection")) < 0:
			errors.append("Block #%d changes a new %s — wire a variable." % [id, "dictionary" if XREBlueprintGraph.on_dictionary(block) else "array"])
		for edge: Dictionary in graph.edges:
			if edge["to"] != id or edge["to_port"] != graph.input_port(block, "collection"): continue
			var source := graph.find_node(edge["from"])
			if source.get("kind") in ["make_array", "make_dictionary"]:
				errors.append("Block #%d changes a new %s — wire a variable." % [id, "dictionary" if source["kind"] == "make_dictionary" else "array"])
	return errors


## The collection a loop or a method works on (D-143): its wire's, else its
## rack's literal, else the scene objects selected for it, by their paths.
static func _held_collection(graph: XREBlueprintGraph, block: Dictionary) -> String:
	var wired := _wired(graph, block, graph.input_port(block, "collection"))
	if not wired.is_empty(): return wired
	var params: Dictionary = block["params"]
	if params.has(XREBlueprintGraph.SCENE_TARGETS): return "_bp_targets(%s, run, %d)" % [_literal(params[XREBlueprintGraph.SCENE_TARGETS], TYPE_NIL), block["id"]]
	return _literal(params.get("collection"), TYPE_NIL)


## What keeps a Break or a Make from building (D-139): no type yet, its class
## gone, a shown field gone from it, a class Make can't build.
static func _validate_struct(graph: XREBlueprintGraph, block: Dictionary) -> PackedStringArray:
	var errors := PackedStringArray()
	var id: int = block["id"]
	var struct: Dictionary = block.get("struct", {})
	if struct.is_empty():
		errors.append("Block #%d: wire its Target to give the Break a type." % id if block["kind"] == "break" else "Block #%d: wire its Result into an input to give the Make a type." % id)
		return errors
	var name := XREBlueprintStructs.name_of(struct)
	if XREBlueprintStructs.describe(int(struct["type"]), str(struct.get("class", "")), block["kind"] == "make").is_empty():
		errors.append("Block #%d: missing class %s." % [id, name])
		return errors
	if block["kind"] == "make" and not XREBlueprintStructs.can_make(int(struct["type"]), str(struct.get("class", ""))):
		errors.append("Block #%d: Make can't build %s: a node, or a class whose _init() wants arguments." % [id, name])
	for field: Dictionary in XREBlueprintStructs.shown(block):
		if field.get("missing", false): errors.append("Block #%d: %s has no field %s." % [id, name, field["name"]])
	return errors


## The operands of an operator, as far as they are known before the game
## runs (D-065): types it takes, no integer division by a literal zero.
static func _validate_operator(graph: XREBlueprintGraph, block: Dictionary) -> PackedStringArray:
	var errors := PackedStringArray()
	var op := XREBlueprintGraph.operator_of(block)
	var a := graph.operand_type(block, "a")
	var b := TYPE_NIL if XREBlueprintOperators.is_unary(op) else graph.operand_type(block, "b")
	# Folded from the left (D-136): the first pair that can't go together is the error.
	var result := XREBlueprintOperators.result_type(op, a, b)
	for index: int in range(2, XREBlueprintGraph.operand_count(block)):
		if result == XREBlueprintOperators.INVALID: break
		a = result
		b = graph.operand_type(block, XREBlueprintOperators.OPERAND_KEYS[index])
		result = XREBlueprintOperators.result_type(op, a, b)
	if result == XREBlueprintOperators.INVALID:
		errors.append("Block #%d: %s" % [block["id"], XREBlueprintOperators.describe(op, a, b)])
	elif op in ["divide", "modulo"] and a == TYPE_INT and not _connected(graph, block["id"], 1) and (block["params"] as Dictionary).get("b") is int and int(block["params"]["b"]) == 0:
		errors.append("Block #%d: division by zero." % block["id"])
	return errors


## Whether a call's argument [param key] keeps a literal on the block.
static func _literal_argument(block: Dictionary, key: String) -> bool:
	if key.begins_with(XREBlueprintFunctions.EXTRA_KEY): return true
	for argument: Dictionary in (block["function"] as Dictionary)["args"]:
		if str(argument.get("key", "")) == key: return XREBlueprintFunctions.has_literal(argument)
	return false


## Unconnected arguments of a call: a literal of the argument's type, or an object with a default.
static func _validate_arguments(graph: XREBlueprintGraph, block: Dictionary) -> PackedStringArray:
	var errors := PackedStringArray()
	var id: int = block["id"]
	var function: Dictionary = block["function"]
	for argument: Dictionary in function["args"]:
		if argument.get("run", false) or argument.get("fixed", false) or argument.get("target", false): continue
		var key := str(argument.get("key", ""))
		var port := graph.input_port(block, key) if not key.is_empty() else -1
		if _connected(graph, id, port): continue
		var type := int(argument["type"])
		if not str(argument.get("type_of", "")).is_empty() and block.has("property_type"): type = int(block["property_type"])
		if XREBlueprintFunctions.has_literal(argument):
			var value: Variant = block["params"][key]
			if not str(argument.get("provider", "")).is_empty() and str(value).strip_edges().is_empty():
				errors.append("Block #%d: choose %s." % [id, str(argument["label"]).to_lower()])
				continue
			if type in [TYPE_STRING_NAME, TYPE_NODE_PATH]: type = TYPE_STRING
			if not XREBlueprintSchema.accepts(type, typeof(value)): errors.append("Block #%d: %s expects %s, got %s." % [id, argument["label"], XREBlueprintSchema.type_name(type), type_string(typeof(value))])
		elif type in XREBlueprintFunctions.WIRED_TYPES and not argument.has("default"):
			errors.append("Block #%d: connect %s." % [id, argument["label"]])
	return errors
