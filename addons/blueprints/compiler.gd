@tool
class_name XREBlueprintCompiler
extends RefCounted
## Typed compiler. Every event invocation owns its arguments and cancellation token.

const HEADER := "# Generated by XRE Blueprints. Edit the .tres graph, not this file.\n"
const RUNTIME := "res://addons/blueprints/runtime_template.txt"
const PURE: Array[String] = ["value", "boolean", "get_property", "equals", "get_variable"]


## Returns code and block-specific diagnostics. Older graphs are upgraded in memory.
static func compile(source: XREBlueprintGraph) -> Dictionary:
	var graph := XREBlueprintGraph.new()
	graph.restore(source.snapshot())
	graph.upgrade()
	var errors := graph.validate()
	if errors.is_empty(): errors.append_array(_validate_program(graph))
	if not errors.is_empty(): return {"code": "", "errors": errors}
	var code := HEADER + "extends Node\n\n"
	for variable: Dictionary in graph.variables:
		code += "var _bp_var_%s: %s = %s\n" % [variable["name"], type_string(typeof(variable["value"])), var_to_str(variable["value"])]
	code += "\n" + FileAccess.get_file_as_string(RUNTIME)
	code += "\n\nfunc _ready() -> void:\n\tpass\n"
	for block: Dictionary in graph.nodes:
		if block["kind"] == "signal":
			var params: Dictionary = block["params"]
			code += "\t_bp_connect(%s, %s, _bp_event%d, %d, %d)\n" % [var_to_str(params["target"]), var_to_str(params["signal"]), block["id"], (block.get("arguments", []) as Array).size(), block["id"]]
	for block: Dictionary in graph.nodes:
		if block["kind"] == "ready": code += "\t_bp_event%d()\n" % block["id"]
	for block: Dictionary in graph.nodes:
		var id: int = block["id"]
		var kind: String = block["kind"]
		var params: Dictionary = block["params"]
		if kind in ["signal", "ready"]:
			var signature := PackedStringArray()
			var arguments := PackedStringArray()
			for index: int in (block.get("arguments", []) as Array).size():
				signature.append("arg%d: Variant" % index)
				arguments.append("arg%d" % index)
			code += "\n\nfunc _bp_event%d(%s) -> void:\n\tvar run := _bp_start(%d, [%s], %s)\n\tif run == null:\n\t\treturn\n\tawait _bp_execute(%d, run)\n\t_bp_end(run)\n" % [id, ", ".join(signature), id, ", ".join(arguments), var_to_str(params["policy"]), id]
		if kind in PURE:
			code += "\n\n# %s #%d\nfunc _bp_value%d(run: _BPRun = null) -> Variant:\n" % [graph.BLOCKS[kind]["title"], id, id]
			match kind:
				"value", "boolean": code += "\treturn %s\n" % var_to_str(params["value"])
				"get_variable": code += "\treturn _bp_var_%s\n" % params["variable"]
				"equals": code += "\treturn _bp_equal(%s, %s)\n" % [_input(graph, block, 0, "a"), _input(graph, block, 1, "b")]
				"get_property": code += "\treturn _bp_read(%s, %s, %d, run, %d)\n" % [_target(graph, block, 0), var_to_str(params["property"]), block.get("property_type", TYPE_NIL), id]
			continue
		code += "\n\n# %s #%d\nfunc _bp_n%d(run: _BPRun) -> int:\n\tif not _bp_alive(run):\n\t\treturn -1\n" % [graph.BLOCKS[kind]["title"], id, id]
		match kind:
			"branch":
				code += "\tvar condition: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(condition, TYPE_BOOL, run, %d):\n\t\treturn -1\n\tif condition:\n%s\telse:\n%s" % [_input(graph, block, 1, "condition"), id, _next(graph, id, 0, "\t\t"), _next(graph, id, 1, "\t\t")]
				continue
			"print": code += "\tvar value: Variant = %s\n\tif _bp_alive(run):\n\t\tprint(value)\n" % _input(graph, block, 1, "value")
			"delay": code += "\tawait _bp_delay(run, %s)\n" % var_to_str(params["seconds"])
			"set_property", "tween":
				code += "\tvar target := %s\n\tvar value: Variant = %s\n" % [_target(graph, block, 2), _input(graph, block, 1, "value")]
				if kind == "set_property": code += "\t_bp_write(target, %s, value, %d, run, %d)\n" % [var_to_str(params["property"]), block.get("property_type", TYPE_NIL), id]
				else: code += "\tawait _bp_tween(target, %s, value, %s, %d, run, %d)\n" % [var_to_str(params["property"]), var_to_str(params["seconds"]), block.get("property_type", TYPE_NIL), id]
			"set_variable":
				var type: int = typeof(graph.find_variable(params["variable"])["value"])
				code += "\tvar value: Variant = %s\n\tif not _bp_alive(run) or not _bp_check_value(value, %d, run, %d):\n\t\treturn -1\n\t_bp_var_%s = value\n" % [_input(graph, block, 1, "value"), type, id, params["variable"]]
			"play_sound": code += "\tvar target := %s\n\tif not _bp_alive(run):\n\t\treturn -1\n\tif not (target is AudioStreamPlayer or target is AudioStreamPlayer2D or target is AudioStreamPlayer3D):\n\t\t_bp_error(run, %d, \"Play Sound needs an audio player.\")\n\t\treturn -1\n\ttarget.call(\"play\")\n" % [_target(graph, block, 1), id]
			"play_animation": code += "\tvar target := %s\n\tif not _bp_alive(run):\n\t\treturn -1\n\tawait _bp_animation(target, %s, %s, %s, run, %d)\n" % [_target(graph, block, 1), var_to_str(params["animation"]), var_to_str(params["wait"]), var_to_str(params["timeout"]), id]
		code += _next(graph, id, 0, "\t")
	code += "\n\n# Iterative execution permits back edges without recursive call-stack growth.\nfunc _bp_execute(block_id: int, run: _BPRun) -> void:\n\tvar steps := 0\n\twhile block_id >= 0 and _bp_alive(run):\n\t\tmatch block_id:\n"
	for block: Dictionary in graph.nodes:
		if block["kind"] in PURE: continue
		code += "\t\t\t%d: block_id = await _bp_n%d(run)\n" % [block["id"], block["id"]]
	code += "\t\t\t_: return\n\t\tsteps += 1\n\t\tif steps >= 64 and block_id >= 0 and _bp_alive(run):\n\t\t\tsteps = 0\n\t\t\tawait get_tree().process_frame\n"
	return {"code": code, "errors": errors}


static func _input(graph: XREBlueprintGraph, block: Dictionary, port: int, fallback: String) -> String:
	for edge: Dictionary in graph.edges:
		if edge["to"] == block["id"] and edge["to_port"] == port:
			var source := graph.find_node(edge["from"])
			if source["kind"] == "signal": return "_bp_argument(run, %d, %d, %d)" % [edge["from"], edge["from_port"] - 1, block["id"]]
			return "_bp_value%d(run)" % edge["from"]
	return var_to_str(block["params"][fallback])


static func _target(graph: XREBlueprintGraph, block: Dictionary, port: int) -> String:
	for edge: Dictionary in graph.edges:
		if edge["to"] == block["id"] and edge["to_port"] == port: return "_bp_node(%s, run, %d)" % [_input(graph, block, port, "target"), block["id"]]
	return "_bp_target(%s, run, %d)" % [var_to_str(block["params"]["target"]), block["id"]]


static func _next(graph: XREBlueprintGraph, id: int, port: int, indent: String) -> String:
	for edge: Dictionary in graph.edges:
		if edge["from"] == id and edge["from_port"] == port: return "%sreturn %d\n" % [indent, edge["to"]]
	return indent + "return -1\n"


static func _validate_program(graph: XREBlueprintGraph) -> PackedStringArray:
	var errors := PackedStringArray()
	var origins: Dictionary = {}
	for event: Dictionary in graph.nodes:
		if not event["kind"] in ["ready", "signal"]: continue
		var pending: Array[int] = [event["id"]]
		var seen: Array[int] = []
		while not pending.is_empty():
			var id: int = pending.pop_back()
			if seen.has(id): continue
			seen.append(id)
			if not origins.has(id): origins[id] = []
			(origins[id] as Array).append(event["id"])
			for edge: Dictionary in graph.edges:
				if edge["from"] == id and graph.ports(graph.find_node(id), false)[edge["from_port"]][1] == graph.EXEC: pending.append(edge["to"])
	for block: Dictionary in graph.nodes:
		var params: Dictionary = block["params"]
		if params.has("target") and str(params["target"]).strip_edges().is_empty():
			var dynamic := false
			for edge: Dictionary in graph.edges:
				if edge["to"] == block["id"] and edge["to_port"] == graph.target_port(block): dynamic = true
			if not dynamic: errors.append("Block #%d: missing target." % block["id"])
		if block["kind"] in ["get_variable", "set_variable"] and graph.find_variable(params["variable"]).is_empty(): errors.append("Block #%d: choose an existing variable." % block["id"])
		if block["kind"] in ["set_property", "tween", "set_variable"]:
			var variable := graph.find_variable(params.get("variable", ""))
			var expected: int = typeof(variable.get("value")) if block["kind"] == "set_variable" else block.get("property_type", TYPE_NIL)
			var connected := false
			for edge: Dictionary in graph.edges:
				if edge["to"] == block["id"] and edge["to_port"] == 1: connected = true
			if not connected and not XREBlueprintSchema.accepts(expected, typeof(params["value"])): errors.append("Block #%d: expected %s, got %s." % [block["id"], XREBlueprintSchema.type_name(expected), type_string(typeof(params["value"]))])
		if block["kind"] in PURE: continue
		var dependencies: Array[int] = [block["id"]]
		var seen: Array[int] = []
		while not dependencies.is_empty():
			var id: int = dependencies.pop_back()
			if seen.has(id): continue
			seen.append(id)
			for edge: Dictionary in graph.edges:
				if edge["to"] != id or graph.ports(graph.find_node(id), true)[edge["to_port"]][1] == graph.EXEC: continue
				var source := graph.find_node(edge["from"])
				if source["kind"] == "signal":
					for origin: int in origins.get(block["id"], []):
						if origin != source["id"]: errors.append("Block #%d uses arguments of Signal #%d but also runs from event #%d." % [block["id"], source["id"], origin])
				else: dependencies.append(source["id"])
	return errors
